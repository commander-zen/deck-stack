# Supabase — required for auth and deck cloud sync
# Get these from your Supabase project: Settings > API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# For production: set VITE_SUPABASE_URL and VITE_SUPABASE_ANON_KEY
# in the Vercel dashboard under Settings > Environment Variables.
# Without these, auth and cloud sync are silently disabled —
# local deck storage still works, but sign-in will throw "Supabase not configured".
